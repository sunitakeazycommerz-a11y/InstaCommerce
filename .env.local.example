# InstaCommerce Local Development Environment Template
# Copy to .local-dev/.env.local or run `./scripts/dev-local.sh up` to auto-generate
# ephemeral local-only RSA-2048 JWT keys and populate `.local-dev/.env.local`.

ENVIRONMENT=local
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
DB_USER=postgres
DB_PASSWORD=devpass

IDENTITY_DB_PASSWORD=devpass
CATALOG_DB_PASSWORD=devpass
INVENTORY_DB_PASSWORD=devpass
ORDER_DB_PASSWORD=devpass
PAYMENT_DB_PASSWORD=devpass
FULFILLMENT_DB_PASSWORD=devpass
NOTIFICATION_DB_PASSWORD=devpass
SEARCH_DB_PASSWORD=devpass
PRICING_DB_PASSWORD=devpass
CART_DB_PASSWORD=devpass
CHECKOUT_DB_PASSWORD=devpass
WAREHOUSE_DB_PASSWORD=devpass
RIDER_DB_PASSWORD=devpass
ROUTING_DB_PASSWORD=devpass
WALLET_DB_PASSWORD=devpass
AUDIT_DB_PASSWORD=devpass
FRAUD_DB_PASSWORD=devpass
FEATURE_FLAG_DB_PASSWORD=devpass

# Go services Postgres helpers
RECONCILIATION_DB_HOST=localhost
RECONCILIATION_DB_PORT=5432
RECONCILIATION_DB_USER=postgres
RECONCILIATION_DB_PASSWORD=devpass
RECONCILIATION_DB_NAME=reconciliation

# Redis & Kafka & Temporal (host-mapped docker-compose ports)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKERS=localhost:9092
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=instacommerce

# Disable GCP Secret Manager and OTLP remote export locally
SPRING_CLOUD_GCP_SECRETMANAGER_ENABLED=false
OTEL_SDK_DISABLED=true
MANAGEMENT_OTLP_TRACING_EXPORT_ENABLED=false
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false

# Internal service-to-service auth token (local dev only)
INTERNAL_SERVICE_TOKEN=local-dev-internal-token

# Third-party integration local placeholders
STRIPE_API_KEY=sk_test_local_placeholder
STRIPE_WEBHOOK_SECRET=whsec_local_placeholder
WEBHOOK_SECRET=whsec_local_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_local_placeholder
PHONEPE_SALT_KEY=phonepe_local_placeholder
PHONEPE_SALT_INDEX=1
SENDGRID_API_KEY=SG.local_placeholder
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=local_twilio_placeholder
GOOGLE_MAPS_API_KEY=local_maps_placeholder

# Ephemeral RSA-2048 JWT keys (single-line Base64 PKCS8/X509 populated by ./scripts/dev-local.sh)
IDENTITY_JWT_PRIVATE_KEY=__REPLACE_WITH_LOCAL_PKCS8_PRIVATE_KEY__
IDENTITY_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
ADMIN_GATEWAY_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
CATALOG_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
INVENTORY_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
ORDER_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
PAYMENT_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
FULFILLMENT_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
NOTIFICATION_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
SEARCH_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
PRICING_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
CART_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
CHECKOUT_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
WAREHOUSE_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
RIDER_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
ROUTING_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
WALLET_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
AUDIT_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
FRAUD_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
FEATURE_FLAG_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__
MOBILE_BFF_JWT_PUBLIC_KEY=__REPLACE_WITH_LOCAL_X509_PUBLIC_KEY__

# Local downstream service URLs for host execution
MOBILE_BFF_PORT=8080
IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
FULFILLMENT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087
SEARCH_SERVICE_URL=http://localhost:8088
PRICING_SERVICE_URL=http://localhost:8089
CART_SERVICE_URL=http://localhost:8090
CHECKOUT_ORCHESTRATOR_URL=http://localhost:8091
WAREHOUSE_SERVICE_URL=http://localhost:8092
RIDER_FLEET_SERVICE_URL=http://localhost:8093
ROUTING_ETA_SERVICE_URL=http://localhost:8094
WALLET_SERVICE_URL=http://localhost:8095
WALLET_LOYALTY_SERVICE_URL=http://localhost:8095
AUDIT_TRAIL_SERVICE_URL=http://localhost:8096
AUDIT_TRAIL_BASE_URL=http://localhost:8096
FRAUD_DETECTION_SERVICE_URL=http://localhost:8097
FEATURE_FLAG_SERVICE_URL=http://localhost:8098
ADMIN_GATEWAY_SERVICE_URL=http://localhost:8099
AI_ORCHESTRATOR_SERVICE_URL=http://localhost:8100
AI_INFERENCE_SERVICE_URL=http://localhost:8101
RIDER_DISPATCH_OPTIMIZER_URL=http://localhost:8102
RECONCILIATION_ENGINE_URL=http://localhost:8107

# Python AI local defaults
AI_ORCHESTRATOR_AUDIT_ENABLED=false
FEATURE_FLAG_REDIS_ENABLED=false
