from collections.abc import Sequence
from typing import Any, Self

class DependencyMixin:
    def __rshift__(self, other: Any) -> Any: ...
    def __rrshift__(self, other: Any) -> Self: ...
    def __lshift__(self, other: Any) -> Any: ...
    def __rlshift__(self, other: Any) -> Self: ...
    def set_downstream(self, task_or_task_list: DependencyMixin | Sequence[DependencyMixin]) -> None: ...
    def set_upstream(self, task_or_task_list: DependencyMixin | Sequence[DependencyMixin]) -> None: ...
