from typing import Any

class TopicPartition:
    topic: str
    partition: int
    offset: int
    def __init__(self, topic: str, partition: int = ..., offset: int = ...) -> None: ...

class KafkaError:
    _PARTITION_EOF: int
    def code(self) -> int: ...
    def str(self) -> str: ...

class KafkaException(Exception): ...

class Message:
    def error(self) -> KafkaError | None: ...
    def value(self) -> bytes | None: ...
    def key(self) -> bytes | None: ...
    def topic(self) -> str: ...
    def partition(self) -> int: ...
    def offset(self) -> int: ...
    def timestamp(self) -> tuple[int, int]: ...
    def headers(self) -> list[tuple[str, bytes | None]] | None: ...

class Consumer:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def subscribe(self, topics: list[str], *args: Any, **kwargs: Any) -> None: ...
    def poll(self, timeout: float = ...) -> Message | None: ...
    def consume(self, num_messages: int = ..., timeout: float = ...) -> list[Message]: ...
    def commit(self, message: Message | None = ..., offsets: list[TopicPartition] | None = ..., asynchronous: bool = ...) -> list[TopicPartition] | None: ...
    def get_watermark_offsets(self, partition: TopicPartition, timeout: float = ..., cached: bool = ...) -> tuple[int, int]: ...
    def committed(self, partitions: list[TopicPartition], timeout: float = ...) -> list[TopicPartition]: ...
    def list_topics(self, topic: str | None = ..., timeout: float = ...) -> Any: ...
    def close(self) -> None: ...

class Producer:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def produce(self, topic: str, value: bytes | str | None = ..., key: bytes | str | None = ..., *args: Any, **kwargs: Any) -> None: ...
    def poll(self, timeout: float = ...) -> int: ...
    def flush(self, timeout: float = ...) -> int: ...
