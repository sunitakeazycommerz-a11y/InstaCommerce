from typing import Any

class _FutureResult:
    def result(self, timeout: float | None = ...) -> Any: ...

class AdminClient:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def list_consumer_groups(self, *args: Any, **kwargs: Any) -> _FutureResult: ...
    def list_consumer_group_offsets(self, request: list[Any], *args: Any, **kwargs: Any) -> dict[Any, _FutureResult]: ...
    def list_topics(self, topic: str | None = ..., timeout: float = ...) -> Any: ...

class ConsumerGroupTopicPartitions:
    group_id: str
    topic_partitions: list[Any] | None
    def __init__(self, group_id: str, topic_partitions: list[Any] | None = ...) -> None: ...
