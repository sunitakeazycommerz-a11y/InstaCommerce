from typing import Any

class Prophet:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def add_seasonality(self, *args: Any, **kwargs: Any) -> Any: ...
    def add_regressor(self, *args: Any, **kwargs: Any) -> Any: ...
    def fit(self, df: Any, *args: Any, **kwargs: Any) -> Prophet: ...
    def make_future_dataframe(self, periods: int, freq: str = ..., include_history: bool = ...) -> Any: ...
    def predict(self, df: Any) -> Any: ...
