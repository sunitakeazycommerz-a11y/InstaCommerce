from typing import Any

class Blob:
    def download_as_text(self, *args: Any, **kwargs: Any) -> str: ...

class Bucket:
    def blob(self, blob_name: str, *args: Any, **kwargs: Any) -> Blob: ...

class Client:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def bucket(self, bucket_name: str, *args: Any, **kwargs: Any) -> Bucket: ...
