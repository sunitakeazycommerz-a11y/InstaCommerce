        subgraph BC_DATA_AI["4. Event Backbone, Lakehouse & AI (Go 5 + Py 2)"]
            direction LR
            subgraph DA_GO["Go Pipelines & Telemetry"]
                direction TB
                OBR["outbox-relay :8103 (Go · x13 · SKIP LOCKED)"]:::go
