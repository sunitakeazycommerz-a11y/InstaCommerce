{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccountUnlocked",
  "type": "object",
  "required": [
    "userId",
    "email",
    "unlockedAt",
    "action"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "unlockedAt": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string"
    }
  }
}
