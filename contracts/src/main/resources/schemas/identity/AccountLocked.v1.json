{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccountLocked",
  "type": "object",
  "required": [
    "userId",
    "email",
    "lockedUntil",
    "reason"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "lockedUntil": {
      "type": "string",
      "format": "date-time"
    },
    "failedAttempts": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    }
  }
}
