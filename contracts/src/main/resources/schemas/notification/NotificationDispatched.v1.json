{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificationDispatched",
  "type": "object",
  "required": ["notificationId", "userId", "channel", "templateId", "status", "dispatchedAt"],
  "properties": {
    "notificationId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "channel": { "type": "string", "enum": ["SMS", "PUSH", "EMAIL", "WHATSAPP"] },
    "templateId": { "type": "string" },
    "recipient": { "type": "string" },
    "status": { "type": "string", "enum": ["QUEUED", "SENT", "DELIVERED", "FAILED"] },
    "dispatchedAt": { "type": "string", "format": "date-time" }
  }
}
