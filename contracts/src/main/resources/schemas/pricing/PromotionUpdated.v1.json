{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromotionUpdated",
  "type": "object",
  "required": [
    "id",
    "name",
    "discountType",
    "discountValue",
    "minOrderCents",
    "active"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "discountType": { "type": "string", "enum": ["PERCENTAGE", "FIXED_AMOUNT"] },
    "discountValue": { "type": "number" },
    "minOrderCents": { "type": "integer", "minimum": 0 },
    "maxDiscountCents": { "type": ["integer", "null"], "minimum": 0 },
    "startAt": { "type": ["string", "null"], "format": "date-time" },
    "endAt": { "type": ["string", "null"], "format": "date-time" },
    "active": { "type": "boolean" },
    "maxUses": { "type": ["integer", "null"], "minimum": 0 },
    "currentUses": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
