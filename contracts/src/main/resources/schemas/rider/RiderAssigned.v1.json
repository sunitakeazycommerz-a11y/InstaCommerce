{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiderAssigned",
  "type": "object",
  "required": ["riderId", "orderId"],
  "properties": {
    "riderId": { "type": "string", "format": "uuid" },
    "orderId": { "type": "string", "format": "uuid" },
    "storeId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "riderName": { "type": "string" },
    "pickupLat": { "type": "number", "description": "Latitude of the pickup store location" },
    "pickupLng": { "type": "number", "description": "Longitude of the pickup store location" },
    "dropoffLat": { "type": "number", "description": "Latitude of the customer dropoff location" },
    "dropoffLng": { "type": "number", "description": "Longitude of the customer dropoff location" },
    "assignedAt": { "type": "string", "format": "date-time" }
  }
}
