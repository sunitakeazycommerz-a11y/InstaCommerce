{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockDriftDetected",
  "description": "Emitted during physical stock reconciliation when counted stock differs from system on-hand balance",
  "type": "object",
  "required": [
    "productId",
    "storeId",
    "systemStock",
    "physicalStock",
    "driftQuantity",
    "onHand",
    "reserved",
    "detectedAt"
  ],
  "properties": {
    "productId": { "type": "string", "format": "uuid" },
    "storeId": { "type": "string", "format": "uuid" },
    "systemStock": { "type": "integer" },
    "physicalStock": { "type": "integer", "minimum": 0 },
    "driftQuantity": { "type": "integer" },
    "onHand": { "type": "integer", "minimum": 0 },
    "reserved": { "type": "integer", "minimum": 0 },
    "detectedAt": { "type": "string", "format": "date-time" }
  }
}
