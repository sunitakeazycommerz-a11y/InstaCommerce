{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliveryStatus",
  "description": "Canonical delivery lifecycle status across fulfillment and routing services",
  "type": "string",
  "enum": [
    "PENDING",
    "ASSIGNED",
    "RIDER_ASSIGNED",
    "PICKED_UP",
    "IN_TRANSIT",
    "EN_ROUTE",
    "NEAR_DESTINATION",
    "DELIVERED",
    "FAILED"
  ]
}
